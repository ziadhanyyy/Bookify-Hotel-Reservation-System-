@{
    ViewData["Title"] = "Payment Result";
    var isSuccess = ViewBag.Message?.ToString().Contains("Successful") ?? false;
    var bookingId = ViewBag.BookingId;
    var amount = ViewBag.Amount;
    var transactionId = ViewBag.TransactionId;
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="payment-result-card">
                @if (isSuccess)
                {
                    <!-- Success State -->
                    <div class="payment-result-icon success">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <h1 class="payment-result-title text-success">Payment Successful!</h1>
                    <p class="payment-result-message">Your booking has been confirmed successfully.</p>
                    
                    <div class="payment-details">
                        @if (bookingId != null)
                        {
                            <div class="detail-item">
                                <i class="fas fa-hashtag"></i>
                                <span><strong>Booking ID:</strong> #@bookingId</span>
                            </div>
                        }
                        
                        @if (amount != null)
                        {
                            <div class="detail-item">
                                <i class="fas fa-dollar-sign"></i>
                                <span><strong>Amount Paid:</strong> $@amount.ToString("F2")</span>
                            </div>
                        }
                        
                        @if (transactionId != null)
                        {
                            <div class="detail-item">
                                <i class="fas fa-receipt"></i>
                                <span><strong>Transaction ID:</strong> @transactionId</span>
                            </div>
                        }
                    </div>
                    
                    <div class="alert alert-success mt-4">
                        <i class="fas fa-info-circle"></i> 
                        <strong>What's next?</strong> You will receive a confirmation email shortly. You can view your booking details in your booking history.
                    </div>
                    
                    <div class="payment-actions mt-4">
                        <a asp-controller="Customer" asp-action="BookingHistory" class="btn btn-primary btn-lg">
                            <i class="fas fa-history"></i> View My Bookings
                        </a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-home"></i> Back to Home
                        </a>
                    </div>
                }
                else
                {
                    <!-- Failed State -->
                    <div class="payment-result-icon failed">
                        <i class="fas fa-times-circle"></i>
                    </div>
                    <h1 class="payment-result-title text-danger">Payment Failed</h1>
                    <p class="payment-result-message">Unfortunately, your payment could not be processed.</p>
                    
                    <div class="payment-details">
                        <div class="detail-item">
                            <i class="fas fa-exclamation-triangle"></i>
                            <span>Your booking was not confirmed.</span>
                        </div>
                    </div>
                    
                    <div class="alert alert-warning mt-4">
                        <i class="fas fa-info-circle"></i> 
                        <strong>Possible reasons:</strong>
                        <ul class="mb-0 mt-2">
                            <li>Insufficient funds</li>
                            <li>Card declined</li>
                            <li>Network error</li>
                            <li>Payment gateway timeout</li>
                        </ul>
                    </div>
                    
                    <div class="alert alert-info mt-3">
                        <i class="fas fa-lightbulb"></i> 
                        <strong>Don't worry!</strong> Your booking details are saved. You can try again or contact our support team for assistance.
                    </div>
                    
                    <div class="payment-actions mt-4">
                        <a asp-controller="Customer" asp-action="BookingHistory" class="btn btn-primary btn-lg">
                            <i class="fas fa-redo"></i> Try Again
                        </a>
                        <a asp-controller="Customer" asp-action="AvailableRooms" class="btn btn-outline-primary">
                            <i class="fas fa-bed"></i> Browse Rooms
                        </a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-home"></i> Back to Home
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .payment-result-card {
        background-color: var(--bg-white);
        border-radius: var(--radius-xl);
        box-shadow: var(--shadow-lg);
        padding: var(--spacing-xxl);
        text-align: center;
        margin-top: var(--spacing-xxl);
        animation: fadeInUp 0.6s ease;
    }

    .payment-result-icon {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto var(--spacing-xl);
        font-size: 4rem;
        animation: scaleIn 0.5s ease;
    }

    .payment-result-icon.success {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        box-shadow: 0 8px 20px rgba(40, 167, 69, 0.3);
    }

    .payment-result-icon.failed {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        color: white;
        box-shadow: 0 8px 20px rgba(220, 53, 69, 0.3);
    }

    .payment-result-title {
        font-size: 2.5rem;
        font-weight: var(--font-weight-bold);
        margin-bottom: var(--spacing-md);
    }

    .payment-result-message {
        font-size: var(--font-size-lg);
        color: var(--text-secondary);
        margin-bottom: var(--spacing-xl);
    }

    .payment-details {
        background-color: var(--bg-color);
        border-radius: var(--radius-lg);
        padding: var(--spacing-lg);
        margin: var(--spacing-xl) 0;
        text-align: left;
    }

    .detail-item {
        display: flex;
        align-items: center;
        gap: var(--spacing-md);
        padding: var(--spacing-sm) 0;
        border-bottom: 1px solid var(--border-light);
    }

    .detail-item:last-child {
        border-bottom: none;
    }

    .detail-item i {
        color: var(--primary-color);
        font-size: var(--font-size-lg);
        width: 24px;
    }

    .payment-actions {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-md);
    }

    .payment-actions .btn {
        width: 100%;
    }

    @* @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes scaleIn {
        from {
            transform: scale(0);
            opacity: 0;
        }
        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    @media (max-width: 768px) {
        .payment-result-card {
            padding: var(--spacing-xl);
            margin-top: var(--spacing-lg);
        } *@

        .payment-result-icon {
            width: 100px;
            height: 100px;
            font-size: 3rem;
        }

        .payment-result-title {
            font-size: 2rem;
        }

        .payment-actions {
            flex-direction: column;
        }
    }
</style>

