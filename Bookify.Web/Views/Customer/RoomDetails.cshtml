@model Bookify.Core.DTOs.RoomDto

<h2>@Model.Name Details</h2>

<p>Type: @Model.Type</p>
<p>Price: @Model.Price</p>
<p>Description: @Model.Description</p>

<a asp-action="StartBooking" asp-route-roomId="@Model.Id" class="btn btn-primary">
    Book Now
</a>

<a asp-action="AvailableRooms">Back to Rooms</a>
