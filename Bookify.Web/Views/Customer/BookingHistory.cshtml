@model IEnumerable<Bookify.Core.DTOs.BookingDto>
@{
    ViewData["Title"] = "Booking History";
}

<div class="container">
    <div class="mb-4">
        <h1 class="mb-2"><i class="fas fa-history"></i> My Booking History</h1>
        <p class="text-secondary">View and manage all your hotel bookings</p>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var booking in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card booking-card">
                        <div class="card-header" style="background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%); color: white;">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0"><i class="fas fa-bed"></i> Room @booking.RoomNumber</h5>
                                @{
                                    var statusClass = booking.Status?.ToLower() == "confirmed" ? "badge-success" :
                                                     booking.Status?.ToLower() == "pending" ? "badge-warning" :
                                                     booking.Status?.ToLower() == "cancelled" ? "badge-danger" : "badge-info";
                                }
                                <span class="badge @statusClass">@booking.Status</span>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="booking-detail mb-3">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="fas fa-calendar-check text-primary me-2"></i>
                                    <div>
                                        <small class="text-muted d-block">Check-In</small>
                                        <strong>@booking.CheckInDate.ToShortDateString()</strong>
                                    </div>
                                </div>
                            </div>

                            <div class="booking-detail mb-3">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="fas fa-calendar-times text-primary me-2"></i>
                                    <div>
                                        <small class="text-muted d-block">Check-Out</small>
                                        <strong>@booking.CheckOutDate.ToShortDateString()</strong>
                                    </div>
                                </div>
                            </div>

                            <div class="booking-detail mb-3">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="fas fa-moon text-primary me-2"></i>
                                    <div>
                                        <small class="text-muted d-block">Duration</small>
                                        <strong>@booking.Nights Night(s)</strong>
                                    </div>
                                </div>
                            </div>

                            <hr>

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <strong>Total Amount:</strong>
                                <span style="font-size: 1.3rem; font-weight: bold; color: var(--success-color);">
                                    $@booking.TotalAmount.ToString("F2")
                                </span>
                            </div>

                            <div class="booking-date mb-3">
                                <small class="text-muted">
                                    <i class="fas fa-clock"></i> Booked on @booking.BookingDate.ToShortDateString()
                                </small>
                            </div>

                            <!-- Review Section -->
                            <div class="review-section mt-3">
                                <form asp-action="AddReview" method="post" class="review-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="BookingId" value="@booking.Id" />
                                    <input type="hidden" name="RoomId" value="@booking.RoomId" />
                                    
                                    <div class="mb-2">
                                        <label class="form-label">
                                            <i class="fas fa-star"></i> Write a Review
                                        </label>
                                        <textarea name="Comment" class="form-control" rows="3" placeholder="Share your experience..."></textarea>

                                    </div>
                                    
                                    <button type="submit" class="btn btn-outline-primary btn-sm w-100">
                                        <i class="fas fa-paper-plane"></i> Submit Review
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-rooms">
            <i class="fas fa-calendar-times"></i>
            <h3>No Bookings Found</h3>
            <p>You haven't made any bookings yet. Start exploring our amazing rooms!</p>
            <a asp-action="AvailableRooms" class="btn btn-primary mt-3">
                <i class="fas fa-bed"></i> Browse Available Rooms
            </a>
        </div>
    }
</div>

<style>
    .booking-card {
        transition: transform var(--transition-base), box-shadow var(--transition-base);
        height: 100%;
    }

    .booking-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-lg);
    }

    .booking-detail {
        border-left: 3px solid var(--primary-color);
        padding-left: var(--spacing-md);
    }

    .review-form {
        background-color: var(--bg-color);
        padding: var(--spacing-md);
        border-radius: var(--radius-md);
    }
</style>
