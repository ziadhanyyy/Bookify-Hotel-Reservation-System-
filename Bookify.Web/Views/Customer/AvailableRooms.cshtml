@model IEnumerable<Bookify.Core.DTOs.RoomDto>
@{
    ViewData["Title"] = "Available Rooms";
}

<div class="container">
    <div class="mb-4">
        <h1 class="mb-2">Available Rooms</h1>
        <p class="text-secondary">Discover our selection of luxurious accommodations</p>
    </div>

    <!-- Search Section -->
    <div class="search-section">
        <form method="get" asp-action="AvailableRooms" class="search-form">
            <input type="text" name="query" class="form-control" placeholder="Search by room name, type, or description..." value="@ViewContext.HttpContext.Request.Query["query"]" />
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-search"></i> Search
            </button>
            @if (!string.IsNullOrEmpty(ViewContext.HttpContext.Request.Query["query"]))
            {
                <a asp-action="AvailableRooms" class="btn btn-outline-secondary">
                    <i class="fas fa-times"></i> Clear
                </a>
            }
        </form>
    </div>

    <!-- Rooms Grid -->
    @if (Model != null && Model.Any())
    {
        <div class="rooms-grid">
            @foreach (var room in Model)
            {
                <div class="room-card">
                    <!-- Room Image -->
                    <div class="room-card-image">
                        @if (!string.IsNullOrEmpty(room.ImageURL))
                        {
                            <img src="@room.ImageURL" alt="@room.Name" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                        }
                        else
                        {
                            <img src="/images/unsplash_CepDpEiALqM.png" alt="@room.Name" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                        }
                        <i class="fas fa-bed" style="display: none;"></i>
                    </div>
                    
                    <!-- Room Details -->
                    <div class="room-card-body">
                        <h3 class="room-card-title">@room.Name</h3>
                        <div class="room-card-type">
                            <i class="fas fa-tag"></i> @room.Type
                        </div>
                        
                        @if (!string.IsNullOrEmpty(room.Description))
                        {
                            <p class="room-card-description">@room.Description</p>
                        }
                        else
                        {
                            <p class="room-card-description">Experience comfort and luxury in this beautifully designed room.</p>
                        }
                        
                        <div class="room-card-price">
                            $@room.Price.ToString("F2")
                            <small>/night</small>
                        </div>
                        
                        <div class="room-card-actions">
                            <a asp-action="RoomDetails" asp-controller="Customer" asp-route-id="@room.Id" class="btn btn-primary">
                                <i class="fas fa-eye"></i> View Details
                            </a>
                            <form asp-action="AddToWishlist" method="post" style="display: inline; margin: 0; flex: 0 0 auto;">
                                <input type="hidden" name="roomId" value="@room.Id" />
                                <button type="submit" class="btn btn-outline-danger" title="Add to Wishlist" style="min-width: auto; padding: 0.75rem 1rem;">
                                    <i class="fas fa-heart"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-rooms">
            <i class="fas fa-bed"></i>
            <h3>No Rooms Available</h3>
            <p>We're sorry, but there are no rooms available at the moment. Please check back later or try adjusting your search criteria.</p>
            <a asp-action="AvailableRooms" class="btn btn-primary mt-3">
                <i class="fas fa-refresh"></i> View All Rooms
            </a>
        </div>
    }
</div>

<style>
    .room-card-actions form {
        flex: 0 0 auto;
    }
    
    .room-card-actions .btn {
        min-width: auto;
    }
</style>
