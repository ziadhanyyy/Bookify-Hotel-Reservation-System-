@model IEnumerable<Bookify.Core.DTOs.RoomDto>

<h2>My Wishlist</h2>

<table>
    <tr>
        <th>Room Number</th>
        <th>Type Number</th>
        
    </tr>
    @foreach (var room in Model)
    {
        <tr>
            <td>@room.RoomNumber</td>
            <td>@room.RoomTypeId</td>
            
        </tr>
    }
</table>

<a asp-action="AvailableRooms">Back to Rooms</a>
