@model Bookify.Core.DTOs.RoomTypeDto
@{
    ViewData["Title"] = "Add Room Type";
    Layout = "_AdminLayout";
}

<div class="admin-page-header">
    <div>
        <h2><i class="fas fa-plus-circle"></i> Add New Room Type</h2>
        <p class="text-secondary mb-0">Create a new room type category</p>
    </div>
    <div>
        <a asp-action="RoomTypes" class="btn btn-admin-outline">
            <i class="fas fa-arrow-left"></i> Back to Room Types
        </a>
    </div>
</div>

<div class="admin-form-card">
    <form asp-action="AddRoomType" method="post">
        @Html.AntiForgeryToken()
        
        <div class="form-group">
            <label asp-for="Name" class="form-label">
                <i class="fas fa-tag"></i> Room Type Name
            </label>
            <input asp-for="Name" class="form-control" placeholder="e.g., Deluxe Suite, Standard Room" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description" class="form-label">
                <i class="fas fa-align-left"></i> Description
            </label>
            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe the room type features and amenities..."></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="PricePerNight" class="form-label">
                <i class="fas fa-dollar-sign"></i> Price Per Night
            </label>
            <input asp-for="PricePerNight"
                   type="number"
                   step="0.01"
                   min="0.01"
                   class="form-control"
                   placeholder="0.00" />

            <span asp-validation-for="PricePerNight" class="text-danger"></span>
            <small class="form-text text-muted">Enter the price per night for this room type</small>
        </div>

        <div class="d-flex gap-3 mt-4">
            <button type="submit" class="btn btn-admin">
                <i class="fas fa-save"></i> Add Room Type
            </button>
            <a asp-action="RoomTypes" class="btn btn-admin-outline">
                <i class="fas fa-times"></i> Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
