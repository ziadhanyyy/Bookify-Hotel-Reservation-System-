
    @model IEnumerable<Bookify.Core.DTOs.RoomTypeDto>

@{
    ViewData["Title"] = "Room Types";


<h2>Room Types</h2>

<a asp-action="AddRoomType" class="btn btn-primary mb-3">Add New Room Type</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Price Per Night</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var rt in Model)
        {
            <tr>
                <td>@rt.Name</td>
                <td>@rt.Description</td>
                <td>@rt.PricePerNight.ToString("C")</td>
               
            </tr>
        }
    </tbody>
</table>

}
