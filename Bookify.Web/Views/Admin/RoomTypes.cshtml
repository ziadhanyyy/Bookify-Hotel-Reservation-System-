@model IEnumerable<Bookify.Core.DTOs.RoomTypeDto>
@{
    ViewData["Title"] = "Room Types";
    Layout = "_AdminLayout";
}

<div class="admin-page-header">
    <div>
        <h2><i class="fas fa-list"></i> Room Types</h2>
        <p class="text-secondary mb-0">Manage all room types</p>
    </div>
    <div>
        <a asp-action="AddRoomType" class="btn btn-admin">
            <i class="fas fa-plus"></i> Add New Room Type
        </a>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="admin-table-wrapper">
        <div class="admin-table-header">
            <h4><i class="fas fa-tags"></i> Room Types List</h4>
            <span class="badge badge-primary">@Model.Count() Type(s)</span>
        </div>
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Price Per Night</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rt in Model)
                    {
                        <tr>
                            <td>
                                <strong>@rt.Name</strong>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(rt.Description))
                                {
                                    <span>@(rt.Description.Length > 50 ? rt.Description.Substring(0, 50) + "..." : rt.Description)</span>
                                }
                                else
                                {
                                    <span class="text-muted">No description</span>
                                }
                            </td>
                            <td>
                                <strong style="color: var(--success-color);">@rt.PricePerNight.ToString("C")</strong>
                            </td>
                            <td>
                                <div class="admin-actions">
                                    <a asp-action="EditRoomType" asp-route-id="@rt.Id"
                                       class="admin-action-btn admin-action-btn-edit" title="Edit Room Type">
                                        <i class="fas fa-edit"></i>
                                    </a>

                                    <form asp-action="DeleteRoomType" asp-route-id="@rt.Id" method="post"
                                          style="display: inline; margin-left: 8px;"
                                          onsubmit="return confirmDelete('room type', '@rt.Name');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="admin-action-btn admin-action-btn-delete" title="Delete Room Type">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="empty-state">
        <i class="fas fa-list"></i>
        <h3>No Room Types Found</h3>
        <p>Get started by adding your first room type.</p>
        <a asp-action="AddRoomType" class="btn btn-admin mt-3">
            <i class="fas fa-plus"></i> Add New Room Type
        </a>
    </div>
}

@section Scripts {
    <script>
        function confirmDelete(type, name) {
            return confirm(`Are you sure you want to delete ${type} "${name}"?\n\nThis action cannot be undone!`);
        }
    </script>
}
