@model Bookify.Core.DTOs.AssignRoleDto
@{
    ViewData["Title"] = "Assign Role";
    Layout = "_AdminLayout";
}

<div class="admin-page-header">
    <div>
        <h2><i class="fas fa-user-tag"></i> Assign Role to User</h2>
        <p class="text-secondary mb-0">Manage user roles and permissions</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-admin-outline">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>
</div>

<div class="admin-form-card">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
        </div>
    }

    <form asp-action="AssignRole" method="post">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label asp-for="Email" class="form-label">
                <i class="fas fa-envelope"></i> User Email
            </label>
            <input asp-for="Email" type="email" class="form-control" placeholder="user@example.com" required />
            <span asp-validation-for="Email" class="text-danger"></span>
            <small class="form-text text-muted">Enter the email address of the user</small>
        </div>

        <div class="form-group">
            <label asp-for="Role" class="form-label">
                <i class="fas fa-user-shield"></i> Role
            </label>
            <select asp-for="Role" class="form-select" required>
                <option value="">-- Select Role --</option>
                <option value="Admin">Admin</option>
                <option value="User">User</option>
            </select>
            <span asp-validation-for="Role" class="text-danger"></span>
            <small class="form-text text-muted">Select the role to assign to this user</small>
        </div>

        <div class="d-flex gap-3 mt-4">
            <button type="submit" class="btn btn-admin">
                <i class="fas fa-check"></i> Assign Role
            </button>
            <a asp-action="Index" class="btn btn-admin-outline">
                <i class="fas fa-times"></i> Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
