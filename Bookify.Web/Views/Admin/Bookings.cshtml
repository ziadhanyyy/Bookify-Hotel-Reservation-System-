@model IEnumerable<Bookify.Core.DTOs.BookingDto>
@{
    ViewData["Title"] = "All Bookings";
    Layout = "_AdminLayout";
}

<div class="admin-page-header">
    <div>
        <h2><i class="fas fa-calendar-check"></i> All Bookings</h2>
        <p class="text-secondary mb-0">View and manage all hotel bookings</p>
    </div>
    <div>
        <span class="badge badge-primary">@(Model?.Count() ?? 0) Booking(s)</span>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="admin-table-wrapper">
        <div class="admin-table-header">
            <h4><i class="fas fa-list"></i> Bookings List</h4>
        </div>
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>User Email</th>
                        <th>Room</th>
                        <th>Check In</th>
                        <th>Check Out</th>
                        <th>Nights</th>
                        <th>Total Amount</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td>
                                <i class="fas fa-user"></i> @b.UserEmail
                            </td>
                            <td>
                                <strong>Room #@b.RoomNumber</strong>
                            </td>
                            <td>@b.CheckInDate.ToShortDateString()</td>
                            <td>@b.CheckOutDate.ToShortDateString()</td>
                            <td>
                                <span class="badge badge-info">@b.Nights Night(s)</span>
                            </td>
                            <td>
                                <strong style="color: var(--success-color);">$@b.TotalAmount.ToString("F2")</strong>
                            </td>
                            <td>
                                @{
                                    var statusClass = b.Status?.ToLower() == "confirmed" ? "badge-success" :
                                                     b.Status?.ToLower() == "pending" ? "badge-warning" :
                                                     b.Status?.ToLower() == "cancelled" ? "badge-danger" : "badge-info";
                                }
                                <span class="badge @statusClass">@b.Status</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="empty-state">
        <i class="fas fa-calendar-times"></i>
        <h3>No Bookings Found</h3>
        <p>There are no bookings in the system yet.</p>
    </div>
}
