@model IEnumerable<Bookify.Core.DTOs.RoomDto>
@{
    ViewData["Title"] = "Rooms";
    Layout = "_AdminLayout";
}

<div class="admin-page-header">
    <div>
        <h2><i class="fas fa-bed"></i> All Rooms</h2>
        <p class="text-secondary mb-0">Manage all hotel rooms</p>
    </div>
    <div>
        <a asp-action="AddRoom" class="btn btn-admin">
            <i class="fas fa-plus"></i> Add New Room
        </a>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="admin-table-wrapper">
        <div class="admin-table-header">
            <h4><i class="fas fa-list"></i> Rooms List</h4>
            <span class="badge badge-primary">@Model.Count() Room(s)</span>
        </div>
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Room Number</th>
                        <th>Room Type ID</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var room in Model)
                    {
                        <tr>
                            <td>
                                <strong>@room.RoomNumber</strong>
                            </td>
                            <td>@room.RoomTypeId</td>
                            <td>
                                <div class="admin-actions">
                                    <a asp-action="RoomDetails" asp-route-id="@room.Id" class="admin-action-btn admin-action-btn-view" title="View Details">
                                        <i class="fas fa-eye"></i>
                                    </a>

                                    <a asp-action="EditRoom" asp-route-id="@room.Id" class="admin-action-btn admin-action-btn-edit" title="Edit Room">
                                        <i class="fas fa-edit"></i>
                                    </a>

                                    <form asp-action="DeleteRoom" asp-route-id="@room.Id" method="post" style="display: inline;"
                                          onsubmit="return confirmDelete('room', '@room.RoomNumber');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="admin-action-btn admin-action-btn-delete" title="Delete Room">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="empty-state">
        <i class="fas fa-bed"></i>
        <h3>No Rooms Found</h3>
        <p>Get started by adding your first room.</p>
        <a asp-action="AddRoom" class="btn btn-admin mt-3">
            <i class="fas fa-plus"></i> Add New Room
        </a>
    </div>
}

@section Scripts {
    <script>
        function confirmDelete(type, name) {
            return confirm(`Are you sure you want to delete ${type} "${name}"?\n\nThis action cannot be undone!`);
        }
    </script>
}
