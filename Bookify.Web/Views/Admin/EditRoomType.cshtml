@model Bookify.Core.DTOs.RoomTypeDto
@{
    ViewData["Title"] = "Add Room Type";
    Layout = "_AdminLayout";
}

<h2>Edit Room Type</h2>

<form asp-action="EditRoomType" method="post">

    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="form-group">
        <label asp-for="PricePerNight"></label>
        <input asp-for="PricePerNight" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Capacity"></label>
        <input asp-for="Capacity" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>
