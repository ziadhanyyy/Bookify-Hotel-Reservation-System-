@{
    ViewData["Title"] = "Home";
}

<nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container-fluid">
        <a class="navbar-brand" href="#">Bookify</a>
        <div class="navbar-nav ms-auto">
            @if (User.Identity.IsAuthenticated)
            {
                <span class="navbar-text me-3">Hello, @User.Identity.Name!</span>
                <form asp-action="Logout" asp-controller="Account" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger">Logout</button>
                </form>
            }
            else
            {
                <a asp-action="Register" asp-controller="Account" class="btn btn-outline-primary me-2">Register</a>
                <a asp-action="Login" asp-controller="Account" class="btn btn-outline-secondary">Login</a>
            }
        </div>
    </div>
</nav>

<div class="container mt-5">
    <div class="row">
        <div class="col-12">
            <h1>Welcome to Bookify</h1>
            <p>This is the home page. @if (User.Identity.IsAuthenticated) {
            <span>You are logged in as @User.Identity.Name.</span>
                        } else
            {

                <span>Please register or login to continue.</span>
            }
</p>
        </div>
    </div>
</div>